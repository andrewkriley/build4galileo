# Galileo observability
GALILEO_API_KEY=
GALILEO_PROJECT=build4galileo
GALILEO_LOG_STREAM=default

# LLM providers — set the one(s) you have keys for.
# LLM_PROVIDER picks the default; the chat UI can still switch per message
# to any provider that has a key (cloud) or base URL (local) set below.
LLM_PROVIDER=anthropic          # anthropic | openai | gemini | vllm | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local, self-hosted providers — no key needed, just point at a running
# server. Setting the base URL is what makes the provider show up in the
# chat UI's dropdown; the model dropdown is then populated live from the
# server's own OpenAI-compatible /v1/models endpoint (whatever you've
# loaded/pulled), so there's no fixed model list to configure here.
VLLM_BASE_URL=                  # e.g. http://localhost:8000/v1
VLLM_MODEL=                     # optional fallback if /v1/models is empty
OLLAMA_BASE_URL=                # e.g. http://localhost:11434/v1
OLLAMA_MODEL=                   # optional fallback if /v1/models is empty
